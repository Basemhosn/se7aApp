# Copy to .env.local for local dev.
# Set the same vars in Vercel project settings (Production + Preview).

# Supabase — required for auth, profile, ledger, storage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Vercel AI Gateway — required for vision scans.
# Local dev: get a key from https://vercel.com/dashboard → AI Gateway → API Keys.
# Vercel deployments: not needed, OIDC handles it automatically.
AI_GATEWAY_API_KEY=
