# Copy to .env.local for local dev.
# Set the same vars in Vercel project settings (Production + Preview).

# Supabase — required for auth, profile, ledger, storage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Anthropic — required for vision scans (plate / menu / body).
# Get a key from https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
