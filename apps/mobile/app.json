{
  "expo": {
    "name": "SE7A",
    "slug": "se7aapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "se7a",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#13110D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.se7a.mobile",
      "appleTeamId": "WFPM8238WC",
      "associatedDomains": [
        "applinks:se7a.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "SE7A uses the camera to scan plates, menus, and physique photos for nutrition and body-composition estimates.",
        "NSPhotoLibraryUsageDescription": "SE7A reads photos from your library to analyze plates and menus.",
        "NSHealthShareUsageDescription": "SE7A reads your weight, body-fat percentage, steps, active energy, and workouts from Apple Health so your dashboard stays in sync automatically.",
        "NSHealthUpdateUsageDescription": "SE7A saves the weigh-ins you log back to Apple Health so both apps stay consistent.",
        "NSMicrophoneUsageDescription": "SE7A uses the microphone so you can log meals by voice — hold to speak, and SE7A converts what you said into logged items.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "app.se7a.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13110D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.WRITE_WEIGHT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "SE7A needs photo access to analyze plates and menus.",
          "cameraPermission": "SE7A needs camera access to scan plates, menus, and physique photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SE7A uses the camera to scan barcodes on packaged foods."
        }
      ],
      "expo-asset",
      "./plugins/withFmtConstevalFix",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#f6b73c"
        }
      ],
      "expo-localization",
      "react-native-health-connect",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "se7a-mobile",
          "organization": "se7a-app"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "252c5b23-9df2-41f6-a066-4d2e2c5fb64f"
      }
    },
    "owner": "basemhosns-team"
  }
}
