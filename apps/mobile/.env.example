# Copy to .env.local. Expo automatically exposes any variable prefixed
# with EXPO_PUBLIC_ to the bundled JavaScript.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Base URL for the SE7A API.
# Local dev: your machine's LAN IP so the simulator can reach it
#   (e.g. http://192.168.1.42:3000)
# Preview/production: https://se7a.app
EXPO_PUBLIC_API_BASE=http://localhost:3000

# Sentry — error tracking. Leave blank to disable in local dev.
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat — public SDK keys (safe to bundle; the sensitive REST key
# lives server-side only). Leave blank in dev to disable IAP flows;
# rc.ts no-ops cleanly when unset.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
